{
    "position": "top",
    "layer": "top",

    "modules-left": ["ext/workspaces"],
    "modules-right": ["group/tray-group", "clock"],

    "ext/workspaces": {
	"format": "{name}",
	"on-click": "activate",
	"all-outputs": false
    },

    "modules-right": ["group/tray-group", "clock"],

    "group/tray-group": {
	"orientation": "inherit",
	"drawer": {
	    "transition-duration": 300,
	    "click-to-reveal": true,
	    "transition-left-to-right": true
	},
	"modules": [
	    "custom/tray-toggle",
	    "tray"
	]
    },

    "custom/tray-toggle": {
	"format": "󰅁",
	"tooltip": false
    },

    "clock": {
	"interval": 60,
	"tooltip": true,
	"format": "{:%m-%d-%Y %H:%M}"
    },

    "tray": {
	"icon-size": 17,
	"spacing": 5
    }
}
